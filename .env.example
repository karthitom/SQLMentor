# =============================================================================
# SQLMentor Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=SQLMentor
APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CSRF_SECRET_KEY=

# Argon2 settings (defaults are production-safe)
# ARGON2_TIME_COST=3
# ARGON2_MEMORY_COST=65536
# ARGON2_PARALLELISM=4

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL (production)
DATABASE_URL=postgresql+asyncpg://sqlmentor:changeme@postgres:5432/sqlmentor

# SQLite (local dev fallback - remove DATABASE_URL above to use this)
# DATABASE_URL=sqlite+aiosqlite:///./sqlmentor.db

POSTGRES_DB=sqlmentor
POSTGRES_USER=sqlmentor
POSTGRES_PASSWORD=changeme

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── AI Provider ───────────────────────────────────────────────────────────────
# Options: openai | azure | ollama | groq | openai-compatible
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Azure OpenAI (if AI_PROVIDER=azure)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-02-01

# Ollama (offline, if AI_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Generic OpenAI-compatible (Groq, Mistral, etc.)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=your-groq-key
# OPENAI_MODEL=llama-3.1-70b-versatile

# ── Email ─────────────────────────────────────────────────────────────────────
# TODO(security): Configure transactional email for production
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sqlmentor.example.com
SMTP_TLS=true

# ── Admin Bootstrap ───────────────────────────────────────────────────────────
# First-run admin account (created on startup if not exists)
ADMIN_EMAIL=admin@sqlmentor.local
ADMIN_PASSWORD=

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=60
RATE_LIMIT_AI_PER_MINUTE=10
RATE_LIMIT_ANALYSIS_PER_MINUTE=5

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Analysis ──────────────────────────────────────────────────────────────────
# Maximum request timeout for lab URL analysis (seconds)
ANALYSIS_REQUEST_TIMEOUT=30
# Maximum response size to store (bytes)
ANALYSIS_MAX_RESPONSE_SIZE=1048576
# Allow only http/https schemes for lab URLs
ANALYSIS_ALLOWED_SCHEMES=http,https

# ── Reports ───────────────────────────────────────────────────────────────────
REPORTS_EXPORT_DIR=/app/exports
MAX_EXPORT_FILE_SIZE_MB=50

# ── Uploads ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Monitoring ────────────────────────────────────────────────────────────────
# Sentry DSN (optional)
# SENTRY_DSN=

# ── Feature Flags ─────────────────────────────────────────────────────────────
FEATURE_REGISTRATION_ENABLED=true
FEATURE_AI_CHAT_ENABLED=true
FEATURE_KNOWLEDGE_BASE_ENABLED=true
FEATURE_REPORTS_ENABLED=true
