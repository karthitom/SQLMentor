.installed.cfg
*.egg
MANIFEST
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/.pnp
frontend/.pnp.js
frontend/.vite/
frontend/dist/
frontend/build/
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Docker
.docker/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Secrets / Environment
.env
.env.*
!.env.example
*.pem
*.key
jwt_secret.txt

# Logs
logs/
*.log
backend/logs/

# Database
*.db
*.sqlite
*.sqlite3

# Alembic
backend/alembic/versions/*.py
!backend/alembic/versions/.gitkeep

# Reports / Exports
backend/exports/
backend/uploads/

